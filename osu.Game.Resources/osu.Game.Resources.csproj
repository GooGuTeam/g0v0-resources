<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Title>g0v0!resources</Title>
    <Product>g0v0!resources</Product>
    <Company>GooGuTeam</Company>
    <Description>Resources (textures, fonts, skins, samples, tracks, shaders and localisation) used by g0v0!, a community fork of ppy/osu-resources.</Description>
  </PropertyGroup>
  <PropertyGroup Label="Nuget">
    <Title>g0v0!resources</Title>
    <PackageId>g0v0.osu.Game.Resources</PackageId>
    <Version>2026.913.0</Version>
    <IsPackable>true</IsPackable>
    <Authors>ppy Pty Ltd &amp; GooGuTeam</Authors>
    <PackageLicenseFile>LICENCE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/GooGuTeam/g0v0-resources</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GooGuTeam/g0v0-resources</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Automated release.</PackageReleaseNotes>
    <copyright>Copyright (c) 2019 ppy Pty Ltd; Copyright (c) 2026 GooGuTeam</copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>g0v0 game resources osu</PackageTags>
  </PropertyGroup>
  <ItemGroup Label="Package Files">
    <None Include="..\LICENCE.md" Pack="true" PackagePath="/" />
    <None Include="..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Beatmaps\**\*" />
    <EmbeddedResource Include="Fonts\**\*" />
    <EmbeddedResource Include="Samples\**\*" />
    <EmbeddedResource Include="Skins\**\*" />
    <EmbeddedResource Include="Shaders\**\*" />
    <EmbeddedResource Include="Textures\**\*" />
    <EmbeddedResource Include="Tracks\**\*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Resolves references to LocalisableString. -->
    <PackageReference Include="ppy.osu.Framework" Version="2026.629.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
